# 9router-deploy environment template
# Copy to .env on the server (/opt/9router/.env) and fill with real values.
# Secrets are copied verbatim from the local ~/.9router/.env — never rotated.
# DO NOT commit real values.

# --- root .env (shared app env) ---
BASE_URL=
CLOUD_URL=
JWT_SECRET=
INITIAL_PASSWORD=
API_KEY_SECRET=
MACHINE_ID_SALT=
DATA_DIR=/app/data
PORT=20128
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_CLOUD_URL=
NODE_ENV=production

# --- env/9router.env (non-secret 9router config) ---
# DATA_DIR=/app/data
# PORT=20128
# NODE_ENV=production

# --- env/9router-api.env (9router-api config) ---
# PORT=20127
# NODE_ENV=production
# NINEROUTER_HOME=/app/9router

# --- env/caddy.env (public site hosts) ---
SITE_DASHBOARD=9router-dashboard.vianhanif.link
SITE_API=9router-api.vianhanif.link

# --- cloudflared/config.yml ---
# tunnel: <tunnel-id>
# credentials-file: /etc/cloudflared/<tunnel-id>.json