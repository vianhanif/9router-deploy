# 9router-api service env — copy to 9router-api.env and fill real values
PORT=20127
NODE_ENV=production
NINEROUTER_HOME=/app/9router
DATA_DIR=/app/data
BASE_URL=http://localhost:20128
CLOUD_URL=http://localhost:20128
JWT_SECRET=<your-jwt-secret>

# Headroom token-saver compression shim (9router-api)
# HEADROOM_COMPRESS_SHIM=on   # default on; set "off" to disable
# HEADROOM_PYTHON=/opt/headroom-venv/bin/python3  # bundled in image
# HEADROOM_COMPRESS_SHIM_DEBUG=0  # set 1 for worker stderr traces
